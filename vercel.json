{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://nvcricbuz.runasp.net/api/:match*"
    },
    {
      "source": "/hubs/:match*",
      "destination": "https://nvcricbuz.runasp.net/hubs/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
